{
  "name": "legalease-backend",
  "version": "1.0.0",
  "description": "TypeScript backend for LegalEase - AI Legal Assistant",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node ./scripts/copy-data.mjs",
    "start": "node dist/index.js",
    "vercel-build": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "legal",
    "ai",
    "chatbot",
    "pakistan"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^0.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "tesseract.js": "^4.1.1",
    "unpdf": "^1.6.0",
    "unzipper": "^0.10.14",
    "uuid": "^9.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.10",
    "@types/supertest": "^6.0.2",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
